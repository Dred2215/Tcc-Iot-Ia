#######################################
# Backend Runtime
#######################################
PORT=8000

#######################################
# Database
# Preferir DATABASE_URL no formato postgresql+psycopg2://user:pass@host:port/db
# Os campos DB_* abaixo servem como fallback de montagem quando
# DATABASE_URL nao esta no formato aceito (ex: veio como jdbc:postgresql://...)
#######################################
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SCHEMA=public

#######################################
# Redis (sessao de login do backend)
# Redis proprio do backend Python, distinto do Redis usado pelo n8n.
#######################################
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SESSION_TTL=3600

#######################################
# n8n Base URLs
#######################################
WEBHOOK_BASE_URL=https://SEU_DOMINIO_N8N/webhook
WEBHOOK_TEST_BASE_URL=https://SEU_DOMINIO_N8N/webhook-test

#######################################
# n8n Specific Endpoints (legado, mantidos para referencia)
#######################################
N8N_LOG_WEBHOOK=
N8N_REDIS_TEST_WEBHOOK=

# Sonda de status (webhook de producao usado pelo botao de diagnostico do frontend)
N8N_STATUS_CHECK=https://SEU_DOMINIO_N8N/webhook/status

#######################################
# Chat Webhook
#######################################
WEBHOOK_MESSAGE_CHAT_RESPONSE=https://SEU_DOMINIO_N8N/webhook/message_input

#######################################
# Seguranca da chamada backend -> n8n
# Header enviado em toda chamada a message_input (comando + prompt),
# validado no n8n via "Header Auth" no node Webhook de entrada.
#######################################
N8N_INTERNAL_SECRET_HEADER=X-Internal-Secret
N8N_INTERNAL_SECRET=

#######################################
# Tuya Cloud
#######################################
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_ENDPOINT=https://openapi.tuyaus.com
TUYA_UID=
TUYA_HOME_ID=

#######################################
# Tuya Device / Scene IDs
#######################################
TUYA_LAMPADA_DEVICE_ID=
TUYA_SENSOR_PORTAO_DEVICE_ID=
TUYA_PORTAO_SCENE_ID=
TUYA_AR_CONDICIONADO_DEVICE_ID=
TUYA_AR_ESCRITORIO_LIGAR_SCENE_ID=
TUYA_AR_ESCRITORIO_DESLIGAR_SCENE_ID=

#######################################
# Google Speech (nao usado no fluxo atual de voz,
# mantido para referencia futura)
#######################################
# GOOGLE_APPLICATION_CREDENTIALS=backend/secret/service-account.json
