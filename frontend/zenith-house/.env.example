# Exemplo de configuracao do frontend (zenith-house).
# Copie para ".env" e ajuste os valores. NAO commite o ".env" real.
# Todas as variaveis expostas ao frontend precisam do prefixo VITE_.

# URL base do backend FastAPI. O frontend fala apenas com o backend
# (login, auth check, chat, cadastro, status, transcricao de voz); o
# backend e quem faz proxy para o n8n quando necessario. Nao ha chamada
# direta frontend -> n8n, nem WebSocket de voz (substituido por upload
# de audio em POST /voice_transcribe).
# Local: http://localhost:8000
VITE_BACKEND_BASE_URL=http://localhost:8000

# Porta do backend local usada quando o app roda em dev server (5173/4173/etc).
VITE_LOCAL_BACKEND_PORT=8000
